{
  "name": "@corejs/runtime",
  "version": "0.1.0",
  "description": "Corejs metadata-driven runtime on Deno",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "deno run --allow-read --allow-write build.ts",
    "test": "deno test --allow-read --allow-write --allow-env",
    "check": "deno check src/**/*.ts"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
