{
  "tasks": {
    "dev": "deno run --watch --allow-all main.ts",
    "start": "deno run --allow-all main.ts"
  },
  "imports": {
    "oak/": "https://deno.land/x/oak@v17.1.3/",
    "@oak/oak": "https://deno.land/x/oak@v17.1.3/mod.ts",
    "pg": "https://esm.sh/pg@8.11.3",
    "@std/yaml": "https://deno.land/std@0.224.0/yaml/mod.ts",
    "@std/path": "https://deno.land/std@0.224.0/path/mod.ts",
    "@std/fs": "https://deno.land/std@0.224.0/fs/mod.ts",
    "jose": "https://deno.land/x/jose@v5.0.0/index.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "include": ["src/"],
    "exclude": ["node_modules/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars", "no-explicit-any", "require-await", "prefer-const", "no-prototype-builtins"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": ["src/"],
    "exclude": ["node_modules/"]
  },
  "test": {
    "include": ["src/"],
    "exclude": ["node_modules/"]
  },
  "nodeModulesDir": "auto",
  "unstable": []
}
