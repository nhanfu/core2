    "Script": "return {\r\n    Add: function () {\r\n        var config = JSON.parse(localStorage.getItem(\"SalesFunction\"));\r\n        var cus = {\r\n            ServiceId: 3,\r\n            ActionId: config[\"DEFAULT_CREATE_OBJECTS_APPROVE\"] ? 1 : 3,\r\n            SaleId: this.Token.UserId\r\n        }\r\n        this.OpenPopup(\"provider-editor\", cus);\r\n    },\r\n    AddCarrier: function () {\r\n        var config = JSON.parse(localStorage.getItem(\"SalesFunction\"));\r\n        var cus = {\r\n            ServiceId: 3,\r\n            ActionId: config[\"DEFAULT_CREATE_OBJECTS_APPROVE\"] ? 1 : 3,\r\n            PartnerTypeIds: \"00671858-0000-0000-8000-d917e69b0ea0\",\r\n            SaleId: this.Token.UserId\r\n        }\r\n        this.OpenPopup(\"provider-editor\", cus);\r\n    },\r\n    AddTruckVendor: function () {\r\n        var config = JSON.parse(localStorage.getItem(\"SalesFunction\"));\r\n        var cus = {\r\n            ServiceId: 3,\r\n            ActionId: config[\"DEFAULT_CREATE_OBJECTS_APPROVE\"] ? 1 : 3,\r\n            PartnerTypeIds: \"006f180c-0000-0000-8000-cffef0f90f93\",\r\n            SaleId: this.Token.UserId\r\n        }\r\n        this.OpenPopup(\"provider-editor\", cus);\r\n    },\r\n    AddOtherVendor: function () {\r\n        var config = JSON.parse(localStorage.getItem(\"SalesFunction\"));\r\n        var cus = {\r\n            ServiceId: 3,\r\n            ActionId: config[\"DEFAULT_CREATE_OBJECTS_APPROVE\"] ? 1 : 3,\r\n            PartnerTypeIds: \"0071182c-0000-0000-8000-9525ecff9240\",\r\n            SaleId: this.Token.UserId\r\n        }\r\n        this.OpenPopup(\"provider-editor\", cus);\r\n    },\r\n    AddAirLine: function () {\r\n        var config = JSON.parse(localStorage.getItem(\"SalesFunction\"));\r\n        var cus = {\r\n            ServiceId: 3,\r\n            ActionId: config[\"DEFAULT_CREATE_OBJECTS_APPROVE\"] ? 1 : 3,\r\n            PartnerTypeIds: \"006d1888-0000-0000-8000-62c8a767bd28\",\r\n            SaleId: this.Token.UserId\r\n        }\r\n        this.OpenPopup(\"provider-editor\", cus);\r\n    },\r\n    AddCoLoader: function () {\r\n        var config = JSON.parse(localStorage.getItem(\"SalesFunction\"));\r\n        var cus = {\r\n            ServiceId: 3,\r\n            ActionId: config[\"DEFAULT_CREATE_OBJECTS_APPROVE\"] ? 1 : 3,\r\n            PartnerTypeIds: \"006d18c0-0000-0000-8000-8e2ef3e0f4c4\",\r\n            SaleId: this.Token.UserId\r\n        }\r\n        this.OpenPopup(\"provider-editor\", cus);\r\n    },\r\n    Edit: function (btn, entity) {\r\n        this.OpenPopup(\"provider-editor\", entity);\r\n    }\r\n}",
