    "Components": [
        {
            "Id": "air_import.Section.1",
            "Order": 1,
            "ComponentType": "Section",
            "Label": "Shipment List",
            "Icon": "fal fa-border-all mr-1",
            "ClassName": "scroll-content",
            "XxlCol": 12,
            "IsTab": true,
            "DisplayBadge": true,
            "Components": [
                {
                    "Id": "Section.Shipment.1",
                    "FieldName": "Shipment",
                    "Order": 1,
                    "ComponentType": "GridView",
                    "Column": 12,
                    "Row": 50,
                    "CanSearch": true,
                    "Label": "BookingALL",
                    "ClassName": "sticky",
                    "Events": "{\"dblclick\":\"Edit\"}",
                    "Query": "{\r\n    \"sql\": \"select * from Shipment as ds where ((ds.InsertedBy = '{TokenUserId}' or ds.UserApprovedIds like '%{TokenUserId}%' or (ds.SaleIds like '%{TokenUserId}%' and ds.ShipmentTypeId = 0) or ds.UserViewIds like '%{TokenUserId}%' or (ds.ReceiverIds like '%{TokenUserId}%' and ds.StatusId = 3) or (ds.ForwardId = '{TokenUserId}' and ds.StatusId = 3)) and TypeId = 2 and ParentId is null)\",\r\n    \"total\": \"select count(ds.Id) as total from Shipment as ds where ((ds.InsertedBy = '{TokenUserId}' or ds.UserApprovedIds like '%{TokenUserId}%' or (ds.SaleIds like '%{TokenUserId}%' and ds.ShipmentTypeId = 0) or ds.UserViewIds like '%{TokenUserId}%' or (ds.ReceiverIds like '%{TokenUserId}%' and ds.StatusId = 3) or (ds.ForwardId = '{TokenUserId}' and ds.StatusId = 3)) and TypeId = 2 and ParentId is null)\",\r\n    \"search\": [\r\n        {\r\n            \"Label\": \"HBL No\",\r\n            \"FieldName\": \"HBLNoSearch\",\r\n            \"Where\": \"exists (select s1.Id from Shipment s1 where s1.ParentId = ds.Id and charindex(@hblnosearch, s1.HblNo) >= 1)\"\r\n        }\r\n    ]\r\n}",
                    "RefName": "Shipment",
                    "PreQuery": "{ \"UserId\": this.Token.UserId }",
                    "OrderBy": "ds.InsertedDate desc"
                }
            ]
        },
        {
            "Id": "air_import.Section.2",
            "Order": 2,
            "ComponentType": "Section",
            "Label": "HAWB List",
            "Icon": "fal fa-plus mr-1",
            "ClassName": "scroll-content",
            "IsTab": true,
            "DisplayBadge": true,
            "Components": [
                {
                    "Id": "Section.Shipment1.2",
                    "FieldName": "Shipment1",
                    "Order": 2,
                    "ComponentType": "GridView",
                    "Column": 12,
                    "Row": 50,
                    "CanSearch": true,
                    "Label": "ShipmentNew",
                    "ClassName": "sticky",
                    "Events": "{\r\n    \"dblclick\": \"EditHbl\"\r\n}",
                    "Query": "{\r\n    \"sql\": \"select * from Shipment as ds where ((ds.InsertedBy = '{TokenUserId}' or ds.UserApprovedIds like '%{TokenUserId}%' or (ds.SaleId = '{TokenUserId}' and ds.ShipmentTypeId = 0) or ds.UserViewIds like '%{TokenUserId}%' or (ds.ReceiverIds like '%{TokenUserId}%') or (ds.ForwardId = '{TokenUserId}')) and TypeId = 2 and ParentId is not null)\",\r\n    \"total\": \"select count(ds.Id) as total from Shipment as ds where ((ds.InsertedBy = '{TokenUserId}' or ds.UserApprovedIds like '%{TokenUserId}%' or (ds.SaleId = '{TokenUserId}' and ds.ShipmentTypeId = 0) or ds.UserViewIds like '%{TokenUserId}%' or (ds.ReceiverIds like '%{TokenUserId}%') or (ds.ForwardId = '{TokenUserId}')) and TypeId = 2 and ParentId is not null)\",\r\n    \"search\": [\r\n        {\r\n            \"Label\": \"HBL No\",\r\n            \"FieldName\": \"HBLNoSearch\",\r\n            \"Where\": \"exists (select s1.Id from Shipment s1 where s1.ParentId = ds.Id and charindex(@hblnosearch, s1.HblNo) >= 1)\"\r\n        }\r\n    ]\r\n}",
                    "RefName": "Shipment",
                    "PreQuery": "{ \"UserId\": this.Token.UserId }",
                    "OrderBy": "ds.InsertedDate desc"
                }
            ]
        }
