        {
            "Id": "shipping_instruction_editor.Button.1",
            "FieldName": "Button",
            "order": 1,
            "ComponentType": "Section",
            "ClassName": "ribbon-group",
            "XxlCol": 12,
            "components": [
                {
                    "Id": "Button.btnPrint.2_4",
                    "FieldName": "btnPrint",
                    "order": 2,
                    "ComponentType": "Pdf",
                    "Column": 1,
                    "Label": "Print",
                    "icon": "fal fa-print",
                    "ClassName": "btn detail-button secondary-outline",
                    "Events": "{\r\n    \"click\": \"PrintPdf\"\r\n}",
                    "query": "\r\nSELECT \r\nFORMAT(si.IssueDate,'dd MMM, yy') AS isseudate,\r\nSUM( ISNULL(ct.Weight,0)) AS sumgw,\r\nSUM(ISNULL(ct.CBM,0)) AS sumcbm,\r\nSUM(ISNULL(ct.PKG,0)) AS sumpkg,\r\n  (SELECT STRING_AGG(CONCAT(contN.Name, ' x ', ROUND(inc.Quantity, 0)), ' & ') AS Containers\r\n     FROM EntityContainer inc\r\n     LEFT JOIN MasterData contN ON inc.ContainerTypeId = contN.Id\r\n     WHERE inc.EntityId = '{Id}') AS Containers\r\n\r\n FROM \r\ndbo.ShipmentSI si LEFT JOIN dbo.EntityContainer ct ON ct.EntityId=si.Id \r\nLEFT JOIN dbo.MasterData loaicont ON loaicont.Id = ct.ContainerTypeId\r\nWHERE si.Id='{Id}' \r\nGROUP BY si.Id, si.IssueDate\r\n\r\nSELECT si.Code,ISNULL(ct.ContainerNo,'') AS contno,\r\n ISNULL(ct.SealNo,0) AS sealno, \r\n ISNULL(ct.PKG,0) as PKG,\r\n ISNULL(ct.Description,'') AS Desctiption, \r\n ISNULL(ct.Weight,0)AS weightt, \r\n ISNULL(ct.CBM,0) AS cbm , ISNULL(loaicont.Name,'') AS tencont\r\n FROM dbo.EntityContainer ct  JOIN dbo.ShipmentSI si ON si.Id = ct.EntityId \r\n LEFT JOIN dbo.MasterData loaicont ON ct.ContainerTypeId=loaicont.Id \r\nWHERE si.Id='{Id}'  and loaicont.Name is not null\r\n",
                    "Template": "<p>&nbsp;</p>\n<table style=\"width: 99.6687%; border-collapse: collapse; height: 206.25px;\" border=\"0\"><colgroup><col style=\"width: 16.5499%;\"><col style=\"width: 1.29296%;\"><col style=\"width: 49.1336%;\"><col style=\"width: 1.29199%;\"><col style=\"width: 5.94763%;\"><col style=\"width: 1.29296%;\"><col style=\"width: 11.5074%;\"><col style=\"width: 6.59412%;\"><col style=\"width: 6.33552%;\"></colgroup>\n<tbody>\n<tr style=\"height: 17.375px;\">\n<td rowspan=\"3\"><span style=\"font-size: 10pt;\">&nbsp;${CLogo}</span></td>\n<td rowspan=\"3\"><span style=\"font-size: 10pt;\">&nbsp;</span></td>\n<td style=\"text-align: center;\" colspan=\"7\" rowspan=\"3\"><span style=\"font-size: 10pt;\"><strong>${CCompanyName}</strong><br>Address: ${CAddress}<br>Hotline:<a href=\"tel:19003133\">1900 3133<br></a>Email:&nbsp;</span></td>\n</tr>\n<tr style=\"height: 17.375px;\"></tr>\n<tr style=\"height: 21px;\"></tr>\n<tr style=\"height: 16.6667px;\">\n<td><span style=\"font-size: 10pt;\">&nbsp;</span></td>\n<td><span style=\"font-size: 10pt;\">&nbsp;</span></td>\n<td style=\"text-align: center;\" colspan=\"7\"><span style=\"font-size: 10pt;\"><strong>&nbsp;</strong></span></td>\n</tr>\n<tr style=\"height: 37.3542px;\">\n<td style=\"text-align: center;\" colspan=\"9\" rowspan=\"3\">\n<div style=\"font-size: 28pt; min-width: 400px; display: inline-block; border-radius: 29px; border: 1px solid rgb(0, 0, 0); text-align: center; font-weight: 600;\">SHIPPING INSTRUCTION</div>\n</td>\n</tr>\n<tr style=\"height: 10px;\"></tr>\n<tr style=\"height: 10px;\"></tr>\n<tr style=\"height: 16.6667px;\">\n<td style=\"width: 65px; text-align: left; vertical-align: top;\"><span style=\"font-size: 10pt;\"><strong>&nbsp;</strong></span></td>\n<td style=\"width: 65px; text-align: left; vertical-align: top;\"><span style=\"font-size: 10pt;\"><strong>&nbsp;</strong></span></td>\n<td style=\"text-align: left; vertical-align: top;\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top;\"><span style=\"font-size: 10pt;\"><strong>&nbsp;</strong></span></td>\n<td style=\"text-align: left; vertical-align: top;\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top;\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top;\" colspan=\"3\">&nbsp;</td>\n</tr>\n<tr style=\"height: 35.8125px;\">\n<td class=\"xl67\" style=\"width: 65px; text-align: left; vertical-align: top;\" width=\"130\" height=\"24\"><span style=\"font-size: 10pt;\"><strong>To</strong></span></td>\n<td style=\"width: 65px; text-align: left; vertical-align: top;\"><span style=\"font-size: 10pt;\"><strong>:</strong></span></td>\n<td style=\"text-align: left; vertical-align: top;\">&nbsp;${Provider}</td>\n<td style=\"text-align: left; vertical-align: top;\"><span style=\"font-size: 10pt;\"><strong>&nbsp;</strong></span></td>\n<td style=\"text-align: left; vertical-align: top;\"><strong>Date</strong></td>\n<td style=\"text-align: left; vertical-align: top;\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top;\" colspan=\"3\">${isseudate}</td>\n</tr>\n<tr style=\"height: 24px;\">\n<td class=\"xl67\" style=\"width: 65px; text-align: left; vertical-align: top;\" width=\"130\" height=\"24\"><span style=\"font-size: 10pt;\"><strong>Attn</strong></span></td>\n<td style=\"width: 65px; text-align: left; vertical-align: top;\"><span style=\"font-size: 10pt;\"><strong>:</strong></span></td>\n<td style=\"text-align: left; vertical-align: top;\">${PIC}</td>\n<td style=\"width: 30.5px; text-align: left; vertical-align: top;\"><span style=\"font-size: 10pt;\"><strong>&nbsp;</strong></span></td>\n<td class=\"xl67\" style=\"width: 15.25px; text-align: left; vertical-align: top;\" width=\"61\" height=\"24\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top;\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top;\" colspan=\"3\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p>Please issue MB/L as Booking No:&nbsp; <span style=\"font-size: 12pt;\"><strong>${Booking No}</strong></span> following details:</p>\n<p>&nbsp;</p>\n<table style=\"border-collapse: collapse; width: 100.043%; height: 127.99px;\" border=\"0\"><colgroup><col style=\"width: 17.6471%;\"><col style=\"width: 9.46292%;\"><col style=\"width: 1.27877%;\"><col style=\"width: 24.5524%;\"><col style=\"width: 1.27877%;\"><col style=\"width: 45.7801%;\"></colgroup>\n<tbody>\n<tr style=\"height: 32.3333px;\">\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">1. SHIPPER:</span></strong></td>\n<td style=\"text-align: left; vertical-align: top;\" colspan=\"5\"><span style=\"font-size: 13.3333px;\">${ShipperDes}</span><br><span style=\"font-size: 13.3333px;\"><br></span></td>\n</tr>\n<tr style=\"height: 16px;\">\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong>2. CONSIGNEE:</strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\" colspan=\"5\">${ConsigneeDes}</td>\n</tr>\n<tr style=\"height: 16px;\">\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\" colspan=\"5\">&nbsp;</td>\n</tr>\n<tr style=\"height: 18.0521px;\">\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">3. Notify party:</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\" colspan=\"5\">${NotifyPartyDes}</td>\n</tr>\n<tr style=\"height: 16px;\">\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\" colspan=\"2\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;</span></strong></td>\n</tr>\n<tr style=\"height: 17.9375px;\">\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\" colspan=\"2\"><strong><span style=\"font-size: 13.3333px;\">4. Port of Loading</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">Port of Discharge</span></strong></td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\">&nbsp;</td>\n<td style=\"text-align: left; vertical-align: top; border-style: hidden;\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;Port of Delivery</span></strong></td>\n</tr>\n<tr style=\"height: 11.6667px;\">\n<td style=\"text-align: left; border-style: hidden;\" colspan=\"2\">&nbsp;</td>\n<td style=\"text-align: left; border-style: hidden;\">&nbsp;</td>\n<td style=\"text-align: left; border-style: hidden;\">&nbsp;</td>\n<td style=\"text-align: left; border-style: hidden;\">&nbsp;</td>\n<td style=\"text-align: left; border-style: hidden;\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p><strong>5. Description of goods</strong></p>\n<p>&nbsp;</p>\n<table style=\"border-collapse: collapse; width: 100.043%; height: 50px;\" border=\"1\"><colgroup><col style=\"width: 20.6097%;\"><col style=\"width: 11.8506%;\"><col style=\"width: 13.2675%;\"><col style=\"width: 27.8231%;\"><col style=\"width: 12.6234%;\"><col style=\"width: 13.7827%;\"></colgroup>\n<thead>\n<tr style=\"height: 16.6667px; text-align: center;\">\n<td><strong>Container/Seal No.</strong></td>\n<td><strong>Type</strong></td>\n<td><strong>Packages</strong></td>\n<td><strong>Description of Goods</strong></td>\n<td><strong>G.W (KGS)</strong></td>\n<td><strong>CBM</strong></td>\n</tr>\n</thead>\n<tbody data-table=\"c0\">\n<tr style=\"height: 16.6667px;\">\n<td>{contno}/{sealno}</td>\n<td style=\"text-align: center;\">{tencont}</td>\n<td style=\"text-align: center;\">{PKG}</td>\n<td>{Desctiption}</td>\n<td style=\"text-align: center;\">{weightt}</td>\n<td style=\"text-align: center;\">{cbm}</td>\n</tr>\n</tbody>\n<tfoot>\n<tr>\n<td style=\"text-align: center;\" colspan=\"2\">TOTAL: ${Containers}</td>\n<td style=\"text-align: center;\">${sumpkg}</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n<td style=\"text-align: center;\">${sumgw}</td>\n<td style=\"text-align: center;\">${sumcbm}</td>\n</tr>\n</tfoot>\n</table>\n<div>&nbsp;</div>\n<div><strong>6. Freight and Charge: <span style=\"font-size: 12pt;\">${Payment term}</span></strong></div>\n<div>Please fax us the draft of MBL to check before issue the original.</div>\n<div>&nbsp;</div>\n<div>Thanks for your Co-operation.</div>\n<div>&nbsp;</div>\n<div>Brgds,</div>"
                },
