{
    "Id": "submit_si_editor",
    "Name": "submit-si-editor",
    "Label": "Submit SI Editor",
    "order": 0,
    "style": "width:1000px;",
    "Script": "return {\r\n    Init: function () {\r\n        window.setTimeout(async () => {\r\n            if (this.Entity.Id.startsWith('-')) {\r\n                await this.SavePatch(false, this.Entity, true);\r\n            }\r\n        }, 500);\r\n    },\r\n    ApprovePatch: async function (com, entity) {\r\n        this.EditForm.Entity.ProgressId = 3;\r\n        this.EditForm.Dirty = true;\r\n        await this.EditForm.SavePatch();\r\n    },\r\n    CalcContainerText: function (com, entity) {\r\n        var grid = this.EditForm.FirstCom(\"EntityContainer\");\r\n        const result1 = grid.Item.filter(x => x.Entity.ContainerType).reduce((acc, x) => {\r\n            const typeName = x.Entity.ContainerType.Name;\r\n            const quantity = this.Decimal(1);\r\n            if (!acc[typeName]) {\r\n                acc[typeName] = this.Decimal(0);\r\n            }\r\n            acc[typeName] = acc[typeName].add(quantity);\r\n            return acc;\r\n        }, {});\r\n        const summary = Object.keys(result1).map(typeName =>\r\n            `${result1[typeName]} x ${typeName}`\r\n        ).join(\" & \");\r\n        this.Entity.ContainerText = summary;\r\n        const result = grid.Item.filter(x => x.Entity.ContainerType).reduce((acc, x) => {\r\n            const typeName = x.Entity.ContainerType.Name;\r\n            const quantity = this.Decimal(x.Entity.PKG || 0);\r\n            const qty = this.Decimal(1);\r\n            const cbm = this.Decimal(x.Entity.CBM || 0);\r\n            const gw = this.Decimal(x.Entity.Weight || 0);\r\n            const unit = x.Entity.UnitId;\r\n            if (!acc[typeName]) {\r\n                acc[typeName] = {\r\n                    PKG: this.Decimal(0),\r\n                    Qty: this.Decimal(0),\r\n                    CBM: this.Decimal(0),\r\n                    Weight: this.Decimal(0),\r\n                    UnitId: null\r\n                };\r\n            }\r\n            acc[typeName].Qty = acc[typeName].Qty.add(qty);\r\n            acc[typeName].PKG = acc[typeName].PKG.add(quantity);\r\n            acc[typeName].CBM = acc[typeName].CBM.add(cbm);\r\n            acc[typeName].Weight = acc[typeName].Weight.add(gw);\r\n            acc[typeName].UnitId = unit;\r\n            return acc;\r\n        }, {});\r\n        const totalQuantity = Object.keys(result).reduce((acc, typeName) => acc.add(result[typeName].PKG), this.Decimal(0));\r\n        const totalCBM = Object.keys(result).reduce((acc, typeName) => acc.add(result[typeName].CBM), this.Decimal(0));\r\n        const totalGW = Object.keys(result).reduce((acc, typeName) => acc.add(result[typeName].Weight), this.Decimal(0));\r\n        const totalUnit = result[Object.keys(result)[0]] ? result[Object.keys(result)[0]].UnitId : '';\r\n        var des = grid.Item.map(x => x.Entity).filter(x => x.Description).map(x => x.Description).join(\"\\n\");\r\n        this.EditForm.Entity.DetailsGoods = des;\r\n        this.EditForm.Entity.Quantity = totalQuantity;\r\n        this.EditForm.Entity.CBM = totalCBM;\r\n        this.EditForm.Entity.GW = totalGW;\r\n        this.EditForm.Entity.UnitId = totalUnit;\r\n        this.UpdateView(false, false, \"Quantity\", \"CBM\", \"GW\", \"UnitId\", \"ContainerText\", \"DetailsGoods\");\r\n    },\r\n    DownloadTemplate: async function () {\r\n        var shipmentContainerGrid = this.EditForm.FirstCom(\"EntityContainer\");\r\n        await shipmentContainerGrid.ExportExcelTemplate();\r\n    },\r\n    UploadContainer: async function () {\r\n        var shipmentContainerGrid = this.EditForm.FirstCom(\"EntityContainer\");\r\n        await shipmentContainerGrid.ImportExcelTemplate();\r\n    },\r\n    OnApprove: function () {\r\n        this.Entity.ProgressId = 3;\r\n        this.Entity.StatusId = 3;\r\n    },\r\n    OnSend: function () {\r\n        this.Entity.ProgressId = 2;\r\n    },\r\n    OnDecline: function () {\r\n        this.Entity.ProgressId = 4;\r\n        this.Entity.StatusId = 4;\r\n    }\r\n}",
    "Events": "{\r\n    \"onapproved\":\"OnApprove\",\r\n    \"onsend\":\"OnSend\",\r\n    \"ondecline\":\"OnDecline\"\r\n}",
