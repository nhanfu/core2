    "components": [
        {
            "Id": "approval_editor.Container.1",
            "FieldName": "Container",
            "order": 1,
            "ComponentType": "Section",
            "XxlCol": 12,
            "XxlOuterColumn": 0,
            "components": [
                {
                    "Id": "Container.Left.1_6",
                    "FieldName": "Left",
                    "order": 1,
                    "ComponentType": "Section",
                    "ClassName": "card-body",
                    "XxlCol": 12,
                    "XxlOuterColumn": 12,
                    "components": [
                        {
                            "Id": "Left.VoucherTypeId.2",
                            "FieldName": "VoucherTypeId",
                            "order": 2,
                            "ComponentType": "Number",
                            "Column": 6,
                            "precision": 0,
                            "Label": "Type",
                            "ShowLabel": true,
                            "disabled": true
                        },
                        {
                            "Id": "Left.NameId.1",
                            "FieldName": "NameId",
                            "order": 1,
                            "ComponentType": "Dropdown",
                            "FormatData": "{Name}",
                            "PlainText": "Select data",
                            "Column": 6,
                            "Row": 100,
                            "Label": "Name",
                            "ShowLabel": true,
                            "PopulateField": "this.EditForm.Entity.VoucherTypeId = this.Matched.Enum;\r\nthis.EditForm.UpdateView(false, false, \"VoucherTypeId\");\r\nreturn null;",
                            "query": "{\r\n    \"sql\": \"select ds.* from [MasterData] as ds left join [MasterData] ds1 on ds.ParentId = ds1.Id where  ds1.Name = N'Voucher Type'\",\r\n    \"total\": \"select count(ds.Id) as total from [MasterData] as ds left join [MasterData] ds1 on ds.ParentId = ds1.Id where  ds1.Name = N'Voucher Type'\"\r\n}",
                            "RefName": "MasterData",
                            "Template": "[{ \"FieldName\" : \"Name\", \"Label\" : \"Name\", \"ComponentType\" : \"Input\" }]"
                        }
                    ]
                },
                {
                    "Id": "Container.Right.2",
                    "FieldName": "Right",
                    "order": 2,
                    "ComponentType": "Section",
                    "ClassName": "card-body",
                    "XxlCol": 12,
                    "XxlOuterColumn": 12,
                    "components": [
                        {
                            "Id": "Right.ApprovalConfig.1",
                            "FieldName": "ApprovalConfig",
                            "order": 1,
                            "ComponentType": "GridView",
                            "Column": 12,
                            "Row": 200,
                            "DefaultVal": "{\r\n    \"ParentId\": this.EditForm.Entity.Id,\r\n    \"VoucherTypeId\": this.EditForm.Entity.VoucherTypeId\r\n}",
                            "CanAdd": true,
                            "query": "{\r\n    \"sql\": \"select * from ApprovalConfig as ds where ParentId = '{ParentId}' and ParentId is not null\",\r\n    \"total\": \"select count(ds.Id) as total from ApprovalConfig as ds where ParentId = '{ParentId}' and ParentId is not null\"\r\n}",
                            "RefName": "ApprovalConfig",
                            "PreQuery": "{\r\n    \"ParentId\": this.EditForm.Entity.Id\r\n}",
                            "editable": true
                        }
                    ]
                },
                {
                    "Id": "Container.btnSave.1",
                    "FieldName": "btnSave",
                    "order": 1,
                    "ComponentType": "Button",
                    "Column": 1,
                    "Label": "Save",
                    "icon": "fal fa-save",
                    "ClassName": "btn detail-button primary",
                    "HotKey": "Ctrl-S",
                    "Events": "{ \"click\" : \"SavePatch\" }"
                }
            ]
