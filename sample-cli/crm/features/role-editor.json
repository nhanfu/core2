                    "Id": "Section.User.1",
                    "FieldName": "User",
                    "order": 1,
                    "ComponentType": "GridView",
                    "Column": 12,
                    "Row": 50,
                    "ChildStyle": "height: calc(100vh - 10.5rem)",
                    "Events": "{\"dblclick\":\"EditUser\"}",
                    "query": "{\r\n    \"sql\": \"select * from [User] as ds where RoleIds like N'%{RoleId}%'\",\r\n    \"total\": \"select count(ds.Id) as total from [User] as ds where RoleIds like N'%{RoleId}%'\"\r\n}",
                    "RefName": "User",
                    "PreQuery": "{\r\n    \"RoleId\" : this.EditForm.Entity.Id\r\n}",
                    "OrderBy": "ds.InsertedDate desc"
                }
            ]
        }
