{
    "Id": "payment_manage",
    "Name": "payment-manage",
    "Label": "Payment Manage",
    "order": 3,
    "Script": "return {\r\n    Add: function () {\r\n        var entity = {\r\n            StatusId: 1,\r\n            ActionId: 2,\r\n            VoucherTypeId: 11,\r\n            InsertedBy: this.Token.UserId,\r\n            FeeTypeId: 0,\r\n            TypeId: 2,\r\n            ObhTypeId: 1,\r\n            PostDate: this.dayjs().format('YYYY-MM-DDTHH:mm:ss'),\r\n            InvoiceDate: this.dayjs().format('YYYY-MM-DDTHH:mm:ss'),\r\n            ExchangeRateINV: this.Decimal(1).div(this.Decimal(JSON.parse(localStorage.getItem(\"ExchangeRateUSD\"))[\"VND\"])),\r\n        }\r\n        this.OpenPopup(\"payment-request-editor\", entity);\r\n    },\r\n    Edit: function (btn, entity) {\r\n        this.OpenPopup(\"payment-request-editor\", { Id: entity.Id }, true);\r\n    },\r\n    OpenFilter: function () {\r\n        var newItem = this.EditForm.GroupTree.find(x => x.FieldName == \"SearchForm\");\r\n        var form = this.EditForm.OpenConfig(\"Update ExchangeRate!\", async () => {\r\n        }, () => { }, true, newItem.Components);\r\n    }\r\n}",
