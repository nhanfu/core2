    "Label": "VAT Invoice",
    "order": 2,
    "Script": "return {\r\n    Add: function () {\r\n        var entity = {\r\n            StatusId: this.SalesFunction[\"APPROVE_VAT_INV\"] ? 3 : 1,\r\n            NoApproved: this.SalesFunction[\"APPROVE_VAT_INV\"] ? true : false,\r\n            VoucherTypeId: 12,\r\n            InsertedBy: this.Token.UserId,\r\n            FeeTypeId: 0,\r\n            TypeId: 3,\r\n            ObhTypeId: 1,\r\n            ActionId: 2,\r\n            PostDate: this.dayjs().format('YYYY-MM-DDTHH:mm:ss'),\r\n            InvoiceDate: this.dayjs().format('YYYY-MM-DDTHH:mm:ss'),\r\n            ExchangeRateINV: this.Decimal(1).div(this.Decimal(JSON.parse(localStorage.getItem(\"ExchangeRateUSD\"))[\"VND\"]))\r\n        }\r\n        this.OpenPopup(\"vatinvoice-editor\", entity);\r\n    },\r\n    Edit: function (btn, entity) {\r\n        this.OpenPopup(\"vatinvoice-editor\", entity);\r\n    }\r\n}",
